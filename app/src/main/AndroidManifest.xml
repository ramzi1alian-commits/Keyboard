<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        IMPORTANT: This app requests NO permissions at all.
        Specifically, android.permission.INTERNET is NOT declared here.
        Android enforces network access at install time based on this manifest -
        an app with no INTERNET permission is physically unable to open a socket,
        make an HTTP request, or send any data anywhere. This is enforced by the
        OS kernel/sandbox, not by app logic, so it cannot be bypassed by a bug
        in this app's own code.
    -->

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ThemeSettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".EncryptActivity"
            android:exported="false"
            android:label="@string/encrypt_title" />

        <activity
            android:name=".ContactPairingActivity"
            android:exported="false"
            android:label="@string/pairing_title" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title" />

        <service
            android:name=".SecureInputMethodService"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true"
            android:label="@string/keyboard_name">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>
</manifest>
