<resources>
    <!--
        MERGED PALETTE (v3) - synthesis of two design passes:
        - Pass A went fully muted/jewel-toned and read as "dusty/washed out".
        - Pass B went fully neon-saturated and read as "gamer RGB", not a
          security product.
        This version keeps confident, clearly-saturated hues (not pastel)
        but pulls them back from pure neon, and keeps backgrounds close to
        true black/white for sharp contrast - the "high-contrast" part of
        pass B without the "electric" part.
    -->
    <!--
        v4 - "modern" pass requested by user feedback: the old palette
        (near-white on near-white, 8-10dp corners, flat single-tone keys)
        read as flat/dated. This keeps the same light, high-contrast
        family but gives the keyboard surface a visibly darker base than
        the keys, so keys read as raised cards (paired with real
        View.elevation in ThemeUtil.keyShape) instead of a flat sheet of
        near-identical grays - closer to a modern Gboard/iOS light theme.
    -->
    <color name="navy_950">#E7ECF4</color>
    <color name="navy_900">#FFFFFF</color>
    <color name="navy_800">#F1F4F9</color>
    <color name="navy_700">#D7DFEC</color>
    <color name="slate_400">#55647A</color>
    <color name="slate_200">#131A26</color>
    <color name="white">#0B0F17</color>

    <!-- Accent palette: shared across day/night. Confident saturation,
         consistent lightness across all four so none reads as an
         afterthought next to the others. -->
    <color name="accent_cyan">#14B8AA</color>    <!-- deep confident teal - default -->
    <color name="accent_cyan_dark">#0C8578</color>
    <color name="danger_red">#E15458</color>

    <color name="accent_teal">#2FBD73</color>    <!-- vivid but not neon emerald -->
    <color name="accent_gold">#E0A030</color>    <!-- warm gold, not caution-yellow -->
    <color name="accent_purple">#9569D6</color>  <!-- rich violet -->

    <!--
        Fixed (NOT overridden in values-night) dark color for text on top
        of an accent-colored button background - must stay dark in both
        day and night mode since the accents are mid-to-high lightness.
    -->
    <color name="text_on_accent">#0A0D14</color>

    <color name="navy_50_light">#F6F8FB</color>
    <color name="white_card">#FFFFFF</color>

    <color name="colorPrimary">@color/navy_900</color>
    <color name="colorPrimaryDark">@color/navy_950</color>
    <color name="colorAccent">@color/accent_cyan</color>
</resources>
