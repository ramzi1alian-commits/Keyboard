<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_950">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تشفير الملفات الآمن"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:text="الملف يُشفّر مرتبطًا بجهة الاتصال المختارة باستخدام ECDH + AES-256-GCM، مع مفتاح الجلسة كعامل إضافي."
            android:textColor="@color/slate_400"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جهة الاتصال الآمنة"
            android:textColor="@color/slate_200"
            android:textSize="13sp" />
        <Spinner
            android:id="@+id/file_contact_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp" />
        <Button
            android:id="@+id/file_add_contact"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="＋ إضافة جهة اتصال آمنة" />
        <TextView
            android:id="@+id/file_selected_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="14dp"
            android:background="@drawable/bg_input"
            android:text="لم يتم اختيار ملف"
            android:textColor="@color/slate_200" />
        <Button
            android:id="@+id/file_pick_encrypt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="🔐 تشفير ملف" />
        <Button
            android:id="@+id/file_pick_decrypt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="🔓 فك تشفير ملف" />
        <TextView
            android:id="@+id/file_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:text="فعّل مفتاح الجلسة من شاشة التشفير أولًا."
            android:textColor="@color/slate_400"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
