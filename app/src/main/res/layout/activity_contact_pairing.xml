<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pairing_instruction"
        android:textColor="@color/slate_200"
        android:textSize="13sp"
        android:gravity="center" />

    <EditText
        android:id="@+id/contact_name_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:hint="@string/pairing_name_hint"
        android:inputType="textCapSentences"
        android:background="@drawable/bg_input"
        android:textColor="@color/slate_200"
        android:textColorHint="@color/slate_400"
        android:padding="12dp" />

    <ImageView
        android:id="@+id/qr_image_view"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/pairing_title" />

    <Button
        android:id="@+id/scan_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/pairing_scan" />

    <TextView
        android:id="@+id/safety_number_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="20sp"
        android:letterSpacing="0.1"
        android:textIsSelectable="true" />

    <Button
        android:id="@+id/confirm_match_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/pairing_confirm" />

</LinearLayout>
